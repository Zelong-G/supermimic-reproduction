# Modified for the local SuperMimic reproduction: keep downloaded assets,
# experiment outputs and local credentials out of research commits.

# Downloaded datasets, model releases and third-party runtimes
# (fetched by scripts, never committed)
/data/
/weights/
/third_party/

# Training, evaluation and export outputs
/logs/
/runs/
/outputs/
/exports/
*.ckpt
*.pt
# Additional pretrained model formats (none are tracked in this project).
*.pth
*.onnx
*.engine
*.safetensors
*.torchscript

# Put new benchmark / tracking / robustness raw outputs under runs/ or outputs/.
# Keep curated reports and figures under docs/; do not globally ignore media,
# JSON, CSV, NPZ, YAML, TOML or BIN files (examples and site assets need them).
/wandb/
/videos/
/recordings/
/tmp/
*.log
events.out.tfevents.*

# Personal research: commit small JSON/CSV summaries and PNG/PDF figures.
# Keep datasets, trajectories, raw render frames and videos local.
/my_work/outputs/**/raw/
/my_work/outputs/**/frames/
/my_work/outputs/**/videos/
/my_work/outputs/**/*.npz
/my_work/outputs/**/*.npy
/my_work/outputs/**/*.h5
/my_work/outputs/**/*.hdf5
/my_work/outputs/**/*.mp4
/my_work/outputs/**/*.webm
/my_work/outputs/**/*.avi
/my_work/outputs/**/*.gif
/my_work/outputs/**/logs/

# BONES-SEED: per-clip results contain motion identifiers and can be large.
# Commit aggregate summaries/figures and the small failure list; keep bulk results local.
/my_work/outputs/exp_006_bones_benchmark/rand2000.json
/my_work/outputs/exp_006_bones_benchmark/hard.json
/my_work/outputs/exp_006_bones_benchmark/full.json

# Native training event files and detailed BONES-SEED evaluations remain local.
/my_work/outputs/exp_007_full_training/**/tb/
/my_work/outputs/exp_007_full_training/**/evaluation/*.json
/my_work/outputs/exp_007_full_training/**/metrics/scalars.csv
/my_work/outputs/exp_007_full_training/**/*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.hypothesis/
.ipynb_checkpoints/
*.egg-info/
/build/
/dist/
.coverage
.coverage.*
/htmlcov/

# Local credentials only; sanitized templates remain available for commits.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc.local
.netrc
.pypirc
/.aws/
/.ssh/
/.secrets/
/secrets/
/credentials/
credentials.json
credentials.local.*
secrets.local.*
id_rsa
id_ed25519
*.private.key

# C++ / CMake
cmake-build-*/
compile_commands.json

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Website: libraries and released model files are fetched at publish time
# (tools/fetch_site_vendor.sh, tools/fetch_site_weights.sh), never committed
/site/vendor/**
!/site/vendor/README.md
/site/assets/policy/
